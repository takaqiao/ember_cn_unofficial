{
  "id": "ember_cn_unofficial",
  "title": "Ember - Chinese Translation [Unofficial]",
  "description": "Ember 战役模块的非官方简体中文翻译：合集正文经 Babele 加载，界面字符串走 Foundry 原生 i18n，同时覆盖 Crucible 与 dnd5e 两侧的包。需自行拥有 Ember 本体（付费模块）与 Babele。Unofficial Simplified Chinese translation for the Ember module.",
  "authors": [
    {
      "name": "Taka"
    }
  ],
  "version": "1.1.29",
  "url": "https://github.com/takaqiao/ember_cn_unofficial",
  "manifest": "https://github.com/takaqiao/ember_cn_unofficial/releases/latest/download/module.json",
  "download": "https://github.com/takaqiao/ember_cn_unofficial/releases/download/v1.1.29/module.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14.999"
  },
  "esmodules": [
    "register.js",
    "scripts/ember-hardcoded-cn.mjs"
  ],
  "languages": [
    {
      "lang": "cn",
      "name": "中文",
      "path": "lang/cn.json"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "babele",
        "type": "module",
        "compatibility": {
          "minimum": "2.9.1"
        }
      },
      {
        "id": "ember",
        "type": "module",
        "compatibility": {
          "minimum": "0.6.0",
          "verified": "0.6.1"
        }
      }
    ]
  },
  "styles": [
    {
      "src": "styles/ember-cn.css",
      "layer": "modules"
    }
  ],
  "bugs": "https://github.com/takaqiao/ember_cn_unofficial/issues",
  "changelog": "https://github.com/takaqiao/ember_cn_unofficial/releases/tag/v1.1.29"
}
