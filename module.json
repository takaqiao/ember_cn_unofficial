{
  "id": "ember_cn_unofficial",
  "title": "Translation:Ember[Unofficial]",
  "description": "Taka初版",
  "authors": [
    {
      "name": "Taka"
    }
  ],
  "version": "1.1.1",
  "url": "https://github.com/takaqiao/ember_cn_unofficial",
  "manifest": "https://github.com/takaqiao/ember_cn_unofficial/releases/latest/download/module.json",
  "download": "https://github.com/takaqiao/ember_cn_unofficial/releases/download/v1.1.1/module.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14.999"
  },
  "esmodules": [
    "register.js",
    "scripts/ember-hardcoded-cn.mjs"
  ],
  "languages": [
    {
      "lang": "cn",
      "name": "中文",
      "path": "lang/cn.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "babele",
        "type": "module",
        "compatibility": {
          "minimum": "2.9.1"
        }
      },
      {
        "id": "ember",
        "type": "module",
        "compatibility": {
          "minimum": "0.6.0",
          "verified": "0.6.0"
        }
      }
    ]
  },
  "styles": [
    "styles/ember-cn.css"
  ]
}
